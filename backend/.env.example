NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gourmet-palace
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Optional override for OAuth callback host (defaults to http://localhost:PORT locally,
# or https://$VERCEL_URL on Vercel).
# API_PUBLIC_URL=http://localhost:4000
SESSION_SECRET=replace-with-strong-random-value
SESSION_NAME=gp.sid
SESSION_MAX_AGE_MS=604800000
SESSION_SECURE=false
# Generate a strong value (PowerShell): $b = [byte[]]::new(48); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
# Or (Node.js): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_ENCRYPTION_KEY=replace-with-separate-strong-random-value
# Required on Vercel for Cron → GET /api/v1/system/cron/daily
CRON_SECRET=replace-with-strong-random-value
# Generate CRON_SECRET with the same command above; use a different value from all other secrets.

# Email: Resend preferred; SMTP is the fallback
RESEND_API_KEY=
RESEND_FROM=Gourmet Palace <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gourmet Palace <noreply@example.com>

# OpenAI server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Square V1 live POS
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/square/callback

# Google GA4 / Search Console / Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# Optional inbound invoice-email webhook secret
INBOUND_INVOICE_SECRET=
PASSWORD_RESET_TTL_MS=3600000
EMAIL_VERIFICATION_TTL_MS=86400000
VERIFICATION_RESEND_COOLDOWN_MS=60000

# Private object storage. Development defaults to local; production requires S3-compatible storage.

# Managed provider credential storage
# Production must use AWS Secrets Manager; development defaults to encrypted local files.
SECRET_STORE_PROVIDER=mongo
SECRET_STORE_PREFIX=gourmet-palace
LOCAL_SECRETS_DIR=storage/secrets
AWS_REGION=us-west-2
# Prefer an ECS task role in AWS. These are optional local/admin fallbacks.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Private object storage
STORAGE_PROVIDER=mongo
LOCAL_STORAGE_DIR=storage/private
S3_BUCKET=
S3_REGION=us-west-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
FILE_SIGNING_SECRET=replace-with-another-strong-random-value

# Manual Google Sync now cooldown per location. Scheduled syncs are unaffected.
GOOGLE_MANUAL_SYNC_COOLDOWN_MINUTES=15

# Vercel-only scheduling/manual sync safety
PROVIDER_HTTP_TIMEOUT_MS=12000
SQUARE_MANUAL_SYNC_COOLDOWN_MINUTES=5
