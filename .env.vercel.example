# Paste these into the Vercel project → Settings → Environment Variables.
# Use Production (and Preview if you want preview deploys to talk to shared staging services).
# After the first deploy, replace APP_URL / CORS_ORIGIN / OAuth redirects with your real domain.
#
# Do NOT put real secrets in this file — it is committed to git. Paste values only in the Vercel UI.

# --- Frontend (build-time) ---
VITE_API_BASE=/api/v1

# --- Core API (required to boot / sign-in) ---
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/gourmet-palace?retryWrites=true&w=majority
APP_URL=https://YOUR_PROJECT.vercel.app
CORS_ORIGIN=https://YOUR_PROJECT.vercel.app
SESSION_SECRET=replace-with-long-random
SESSION_NAME=gp.sid
SESSION_SECURE=true
FILE_SIGNING_SECRET=replace-with-long-random
SECRET_ENCRYPTION_KEY=replace-with-long-random
CRON_SECRET=replace-with-long-random

# --- Storage / secrets on Vercel (ok for first bring-up; prefer aws + s3 for durable prod) ---
SECRET_STORE_PROVIDER=local
STORAGE_PROVIDER=local
LOCAL_SECRETS_DIR=/tmp/gp-secrets
LOCAL_STORAGE_DIR=/tmp/gp-storage

# --- Optional AWS (when you switch providers to aws / s3) ---
# SECRET_STORE_PROVIDER=aws
# STORAGE_PROVIDER=s3
# S3_BUCKET=your-private-bucket
# S3_REGION=us-west-2
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Email ---
RESEND_API_KEY=
RESEND_FROM=Gourmet Palace <noreply@your-domain.com>

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Square ---
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/api/v1/integrations/square/callback

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/api/v1/integrations/google/callback
